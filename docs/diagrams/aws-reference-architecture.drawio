        <mxCell id="drnote" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" value="Pilot light: no compute runs here. Recovery = Terraform apply into this region, restore RDS from the copied snapshots, point Active Storage at the replica bucket, and Route 53 health-check failover flips DNS. RTO is the apply + restore time; RPO is the snapshot/replication lag." vertex="1">
          <mxGeometry height="150" width="480" x="1800" y="380" as="geometry" />
        </mxCell>
        <mxCell id="drnote2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#00A4A6;whiteSpace=wrap;" value="Local realization: demonstrated on paper and, at most, as a second floci endpoint — region-level DR is the one layer of the reference that stays reference-only." vertex="1">
          <mxGeometry height="90" width="480" x="1800" y="550" as="geometry" />
        </mxCell>
